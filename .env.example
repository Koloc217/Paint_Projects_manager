# Скопируйте в .env и заполните. Файл .env не публикуйте.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# SOCKS5-прокси для доступа к Telegram (оставьте пустым, если Telegram доступен напрямую)
# пример: socks5://user:password@host:1080
PROXY_URL=

# HTTPS: 1 включает шифрование (самоподписанный сертификат создаётся при первом запуске в certs/)
HTTPS=
# Порт веб-приложения (по умолчанию 8000, для HTTP и для HTTPS)
PORT=
# Дополнительные имена и IP в сертификате через запятую, например: hub.local,192.168.1.50
TLS_NAMES=
# Свой сертификат вместо самоподписанного (оба пути сразу, например от mkcert)
SSL_CERTFILE=
SSL_KEYFILE=

# Адрес веб-приложения Google Apps Script для бэкапа в Google Sheets (нужен только для автобэкапа)
APPS_SCRIPT_URL=
