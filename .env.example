# Copy to .env and fill in. Never publish the .env file.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Proxy for Telegram, optional. Leave empty if Telegram is reachable directly.
# It is easier to set it in the app: Settings → Telegram → "Proxy for Telegram" (with a connection check).
# The value here is used until a proxy has been saved in the app at least once.
# Formats: socks5://user:password@host:1080, socks5h://..., http://host:3128
PROXY_URL=

# HTTPS: 1 turns encryption on (a self-signed certificate is created in certs/ on the first start)
HTTPS=
# Port of the web app (default 8000, for both HTTP and HTTPS)
PORT=
# Extra host names and IPs for the certificate, comma-separated, for example: hub.local,192.168.1.50
TLS_NAMES=
# Your own certificate instead of the self-signed one (both paths, for example from mkcert)
SSL_CERTFILE=
SSL_KEYFILE=

# URL of the Google Apps Script web app for the Google Sheets backup (only needed for the automatic backup)
APPS_SCRIPT_URL=
